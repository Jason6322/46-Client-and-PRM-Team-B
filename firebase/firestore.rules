rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Role checked against Firestore document (not custom claims).
    // For performance-critical rules, use hasCustomClaim() instead.
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.role == 'admin';
    }

    // Role checked against Firebase Auth custom claims — no Firestore read needed.
    // Set custom claims via Admin SDK: adminAuth.setCustomUserClaims(uid, { admin: true })
    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token[claim] == true;
    }

    // Invite-only access: a signed-in Firebase account is not enough (anyone can
    // create one, e.g. with Google). Only people an admin added at /admin have
    // a users/{uid} profile, and deactivating sets its deletedAt.
    function isMember() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.get('deletedAt', null) == null;
    }

    // Soft-delete guard — filters out logically deleted documents.
    // Include in read rules: allow read: if isOwner(userId) && notDeleted();
    function notDeleted() {
      return resource == null || !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    // ── Collections ────────────────────────────────────────────────────────

    // users/{userId}
    // Each user can only read and update their own profile.
    // Admins can read any profile.
    // Profiles are created only by an admin from /admin (Admin SDK) — sign-up is
    // invite-only, so a client may never create its own.
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin()) && notDeleted();

      allow create: if false;

      // A user may change only their display name (AuthProvider backfills it
      // from Auth). Everything else — role, email, deletedAt — is Admin SDK only.
      allow update: if isAuthenticated() && isOwner(userId) && notDeleted()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;

      allow delete: if false; // soft-delete only — set deletedAt field instead
    }

    // organisations/{organisationId}
    // Team-shared: every team member (isMember) works the same organisations.
    //
    // All writes go through the Server Actions in
    // frontend/src/features/organisations/actions/, which use the Admin SDK
    // (rules do not apply to it) and are where input is validated with Zod,
    // stage changes are recorded as activity, and archiving is a soft delete.
    // Archived organisations are kept until a team member permanently deletes
    // one from the archive screen (deleteOrganisationPermanently, Admin SDK).
    // A client-SDK write would skip all of that, so clients may only read.
    //
    // Archived organisations (deletedAt set) are hidden from client reads; the
    // archive screen reads them server-side. A client list query must therefore
    // filter on where('deletedAt', '==', null) or the whole query is denied.
    match /organisations/{organisationId} {
      allow read: if isMember() && notDeleted();
      allow write: if false;

      // organisations/{organisationId}/activities/{activityId}
      // Stage changes and logged meetings, calls, emails and notes. Archived
      // entries stay readable — the timeline shows them in its archive section
      // so they can be restored. Written only by the Server Actions, as above.
      match /activities/{activityId} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // Add new collection rules above this comment using the /firebase-collection skill.

    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
