{
  "name": "46-client-and-prm-team-b",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/sync-env.js && pnpm --filter frontend dev",
    "env:sync": "node scripts/sync-env.js",
    "build": "pnpm --filter frontend build",
    "test": "pnpm --filter frontend test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "bootstrap": "node scripts/bootstrap.js",
    "validate": "node scripts/validate-placeholders.js",
    "hooks": "lefthook install",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^1.11.13",
    "next": "16.3.8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
